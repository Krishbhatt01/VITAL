% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (data);
\chainin (read) [join=by ProcessHVA];
\chainin (mod) [join=by ProcessHVA];
\chainin (cfg) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (plant) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (lin) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (lin) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (lin);
\chainin (sim) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (sim);
\chainin (rot) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\chainin (ver) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(data) edge [DataLine] (data-read)
(read) edge [DataLine] (read-mod)
(mod) edge [DataLine] (mod-cfg)
(mod) edge [DataLine] (mod-plant)
(phys) edge [DataLine] (phys-plant)
(cfg) edge [DataLine] (cfg-plant)
(plant) edge [DataLine] (plant-trim)
(trim) edge [DataLine] (trim-plant)
(trim) edge [DataLine] (trim-lin)
(plant) edge [DataLine] (plant-lin)
(lin) edge [DataLine] (lin-plant)
(trim) edge [DataLine] (trim-sim)
(plant) edge [DataLine] (plant-sim)
(sim) edge [DataLine] (sim-plant)
(phys) edge [DataLine] (phys-rot)
(cfg) edge [DataLine] (cfg-rot)
(mod) edge [DataLine] (mod-rot)
(sim) edge [DataLine] (sim-rot)
(rot) edge [DataLine] (rot-sim)
(rot) edge [DataLine] (rot-ver)
(trim) edge [DataLine] (right_output_trim)
(lin) edge [DataLine] (right_output_lin)
(sim) edge [DataLine] (right_output_sim)
(ver) edge [DataLine] (right_output_ver)
% Vertical edges
(data-read) edge [DataLine] (read)
(read-mod) edge [DataLine] (mod)
(mod-cfg) edge [DataLine] (cfg)
(mod-plant) edge [DataLine] (plant)
(phys-plant) edge [DataLine] (plant)
(cfg-plant) edge [DataLine] (plant)
(plant-trim) edge [DataLine] (trim)
(trim-plant) edge [DataLine] (plant)
(trim-lin) edge [DataLine] (lin)
(plant-lin) edge [DataLine] (lin)
(lin-plant) edge [DataLine] (plant)
(trim-sim) edge [DataLine] (sim)
(plant-sim) edge [DataLine] (sim)
(sim-plant) edge [DataLine] (plant)
(phys-rot) edge [DataLine] (rot)
(cfg-rot) edge [DataLine] (rot)
(mod-rot) edge [DataLine] (rot)
(sim-rot) edge [DataLine] (rot)
(rot-sim) edge [DataLine] (sim)
(rot-ver) edge [DataLine] (ver)
(cfg) edge [DataLine] (output_cfg)
(trim) edge [DataLine] (output_trim)
(sim) edge [DataLine] (output_sim)
(rot) edge [DataLine] (output_rot)
(ver) edge [DataLine] (output_ver);
\end{pgfonlayer}

