&
\node [DataIO] (right_output_sab) {$\begin{array}{c}\text{DETECTED /} \\ \text{NOT DETECTED}\end{array}$};\\
%Row 5
&
&
&
\node [DataInter] (child-sab) {$\text{did a test fail?}$};&
