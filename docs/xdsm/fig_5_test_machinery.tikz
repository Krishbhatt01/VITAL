\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
&
&
&
\node [DataIO] (output_sab) {$\begin{array}{c}\text{sabotages.json:} \\ \text{file, pattern, targets}\end{array}$};&
&
&
\node [DataIO] (output_docs) {$\begin{array}{c}\text{FAILURE\_CATALOGUE.md,} \\ \text{MANIFEST.json}\end{array}$};&
&
\\
%Row 1
\node [Function] (tests) {$\begin{array}{c}\text{1: Test files} \\ \texttt{tests/M0 ... M6}\end{array}$};&
\node [DataInter] (tests-run) {$\text{test classes}$};&
&
\node [DataInter] (tests-sab) {$\text{target test names}$};&
&
&
&
&
\\
%Row 2
&
\node [Function] (run) {$\begin{array}{c}\text{2: Run the gate} \\ \texttt{run\_vital\_tests}\end{array}$};&
\node [DataInter] (run-cls) {$\begin{array}{c}\text{results +} \\ \text{diagnostics}\end{array}$};&
&
&
&
&
&
\\
%Row 3
&
&
\node [Function] (cls) {$\begin{array}{c}\text{3: Classify} \\ \texttt{+test/classifyResults}\end{array}$};&
&
&
&
&
&
\node [DataIO] (right_output_cls) {$\begin{array}{c}\text{PASS, RED, VACUOUS,} \\ \text{REGRESSION, gateOK}\end{array}$};\\
%Row 4
&
&
&
\node [MDA] (sab) {$\begin{array}{c}\text{4: Plant bugs, one by one} \\ \texttt{run\_sabotage}\end{array}$};&
\node [DataInter] (sab-child) {$\begin{array}{c}\text{mutated copy,} \\ \text{target tests}\end{array}$};&
\node [DataInter] (sab-hash) {$\text{real tree}$};&
