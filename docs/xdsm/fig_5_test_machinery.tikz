% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (tests);
\chainin (run) [join=by ProcessHVA];
\chainin (cls) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (tests);
\chainin (sab) [join=by ProcessHVA];
\chainin (child) [join=by ProcessHVA];
\chainin (sab) [join=by ProcessHVA];
\chainin (hash) [join=by ProcessHVA];
\chainin (sab) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(tests) edge [DataLine] (tests-run)
(run) edge [DataLine] (run-cls)
(tests) edge [DataLine] (tests-sab)
(sab) edge [DataLine] (sab-child)
(child) edge [DataLine] (child-sab)
(sab) edge [DataLine] (sab-hash)
(hash) edge [DataLine] (hash-sab)
(docs) edge [DataLine] (docs-tests)
(cls) edge [DataLine] (right_output_cls)
(sab) edge [DataLine] (right_output_sab)
% Vertical edges
(tests-run) edge [DataLine] (run)
(run-cls) edge [DataLine] (cls)
(tests-sab) edge [DataLine] (sab)
(sab-child) edge [DataLine] (child)
(child-sab) edge [DataLine] (sab)
(sab-hash) edge [DataLine] (hash)
(hash-sab) edge [DataLine] (sab)
(docs-tests) edge [DataLine] (tests)
(sab) edge [DataLine] (output_sab)
(docs) edge [DataLine] (output_docs);
\end{pgfonlayer}

\end{tikzpicture}
