\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
&
&
&
&
\node [DataIO] (output_gen) {$\begin{array}{c}\text{alpha, beta, speed,} \\ \text{p q r, el ail rdr}\end{array}$};&
&
&
\\
%Row 1
\node [Function] (files) {$\begin{array}{c}\text{1: NASA DAVE-ML files} \\ \texttt{F16\_aero/prop/inertia/control/gnc.dml}\end{array}$};&
\node [DataInter] (files-read) {$\text{XML text}$};&
&
&
&
&
&
\\
%Row 2
&
\node [Function] (read) {$\begin{array}{c}\text{2: read} \\ \texttt{+daveml/read}\end{array}$};&
\node [DataInter] (read-comp) {$\begin{array}{c}\text{model struct:} \\ \text{variables, tables, equations}\end{array}$};&
&
&
\node [DataInter] (read-chk) {$\text{NASA check shots}$};&
&
\\
%Row 3
&
&
\node [Function] (comp) {$\begin{array}{c}\text{3: compile} \\ \texttt{+daveml/compile}\end{array}$};&
&
\node [DataInter] (comp-gen) {$\begin{array}{c}\text{writes function} \\ \texttt{out = f(in)}\end{array}$};&
&
&
\\
%Row 4
&
&
&
\node [Function] (look) {$\begin{array}{c}\text{4: lookup, piecewise} \\ \texttt{+daveml/lookup, piecewise}\end{array}$};&
\node [DataInter] (look-gen) {$\begin{array}{c}\text{interpolation} \\ \text{used at run time}\end{array}$};&
&
&
\\
%Row 5
&
&
&
&
\node [Function] (gen) {$\begin{array}{c}\text{5: Generated models} \\ \texttt{+models/+f16/aero, prop, ...}\end{array}$};&
\node [DataInter] (gen-chk) {$\text{model outputs}$};&
&
\node [DataIO] (right_output_gen) {$\begin{array}{c}\text{CX CY CZ} \\ \text{Cl Cm Cn}\end{array}$};\\
%Row 6
&
&
&
&
&
\node [Function] (chk) {$\begin{array}{c}\text{6: Replay NASA check data} \\ \texttt{+daveml/runCheckData}\end{array}$};&
&
\node [DataIO] (right_output_chk) {$\begin{array}{c}\text{pass / fail} \\ \text{25 of 25 shots}\end{array}$};\\
%Row 7
&
&
&
&
&
&
&
\\
};

% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (files);
\chainin (read) [join=by ProcessHVA];
\chainin (comp) [join=by ProcessHVA];
\chainin (gen) [join=by ProcessHVA];
\chainin (chk) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (look);
\chainin (gen) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(files) edge [DataLine] (files-read)
(read) edge [DataLine] (read-comp)
(read) edge [DataLine] (read-chk)
(comp) edge [DataLine] (comp-gen)
(look) edge [DataLine] (look-gen)
(gen) edge [DataLine] (gen-chk)
(gen) edge [DataLine] (right_output_gen)
(chk) edge [DataLine] (right_output_chk)
% Vertical edges
(files-read) edge [DataLine] (read)
(read-comp) edge [DataLine] (comp)
(read-chk) edge [DataLine] (chk)
(comp-gen) edge [DataLine] (gen)
(look-gen) edge [DataLine] (gen)
(gen-chk) edge [DataLine] (chk)
(gen) edge [DataLine] (output_gen);
\end{pgfonlayer}

\end{tikzpicture}
