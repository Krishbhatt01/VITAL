\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
\node [DataIO] (output_split) {$\begin{array}{c}\text{x: 13 states} \\ \text{v\_b, w\_b, q, p\_n}\end{array}$};&
\node [DataIO] (output_atm) {$\text{temperature offset}$};&
\node [DataIO] (output_air) {$\text{wind (NED)}$};&
\node [DataIO] (output_loads) {$\begin{array}{c}\text{u: elevator, aileron,} \\ \text{rudder, throttle}\end{array}$};&
\node [DataIO] (output_sum) {$\begin{array}{c}\text{AC: CG, mass} \\ \text{gravity g}\end{array}$};&
\node [DataIO] (output_eom) {$\text{AC: mass, inertia J}$};&
&
\\
%Row 1
\node [Function] (split) {$\begin{array}{c}\text{1: Unpack the state} \\ \texttt{quat2dcm}\end{array}$};&
\node [DataInter] (split-atm) {$\text{height h = -p\_N(3)}$};&
\node [DataInter] (split-air) {$\begin{array}{c}\text{v\_b, w\_b,} \\ \text{C\_bn}\end{array}$};&
&
\node [DataInter] (split-sum) {$\text{C\_bn (gravity)}$};&
\node [DataInter] (split-eom) {$\text{v, w, q}$};&
&
\\
%Row 2
&
\node [Function] (atm) {$\begin{array}{c}\text{2: Atmosphere} \\ \texttt{atmosphereUS76}\end{array}$};&
\node [DataInter] (atm-air) {$\text{density, sound speed}$};&
\node [DataInter] (atm-loads) {$\text{Mach, h}$};&
&
&
&
\\
%Row 3
&
&
\node [Function] (air) {$\begin{array}{c}\text{3: Air data} \\ \texttt{airData}\end{array}$};&
\node [DataInter] (air-loads) {$\begin{array}{c}\text{V, alpha, beta,} \\ \text{q-bar, p q r}\end{array}$};&
&
&
&
\\
%Row 4
&
&
&
\node [Function] (loads) {$\begin{array}{c}\text{4: F-16 loads} \\ \texttt{+aircraft/+f16/loads}\end{array}$};&
\node [DataInter] (loads-sum) {$\begin{array}{c}\text{F, M about the} \\ \text{reference point}\end{array}$};&
&
&
\node [DataIO] (right_output_loads) {$\begin{array}{c}\text{y: forces,} \\ \text{coefficients}\end{array}$};\\
%Row 5
&
&
&
&
\node [Function] (sum) {$\begin{array}{c}\text{5: Sum at the CG + gravity} \\ \texttt{sumLoadsAtCG}\end{array}$};&
\node [DataInter] (sum-eom) {$\text{F\_b, M\_cg}$};&
&
\\
%Row 6
&
&
&
&
&
\node [Function] (eom) {$\begin{array}{c}\text{6: Rigid-body motion} \\ \texttt{rigidBodyDerivs}\end{array}$};&
&
\node [DataIO] (right_output_eom) {$\begin{array}{c}\text{xdot (13)} \\ \text{the answer}\end{array}$};\\
%Row 7
&
&
&
&
&
&
&
\\
};

% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (split);
\chainin (atm) [join=by ProcessHVA];
\chainin (air) [join=by ProcessHVA];
\chainin (loads) [join=by ProcessHVA];
\chainin (sum) [join=by ProcessHVA];
\chainin (eom) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(split) edge [DataLine] (split-atm)
(split) edge [DataLine] (split-air)
(atm) edge [DataLine] (atm-air)
(air) edge [DataLine] (air-loads)
(atm) edge [DataLine] (atm-loads)
(loads) edge [DataLine] (loads-sum)
(split) edge [DataLine] (split-sum)
(sum) edge [DataLine] (sum-eom)
(split) edge [DataLine] (split-eom)
(eom) edge [DataLine] (right_output_eom)
(loads) edge [DataLine] (right_output_loads)
% Vertical edges
(split-atm) edge [DataLine] (atm)
(split-air) edge [DataLine] (air)
(atm-air) edge [DataLine] (air)
(air-loads) edge [DataLine] (loads)
(atm-loads) edge [DataLine] (loads)
(loads-sum) edge [DataLine] (sum)
(split-sum) edge [DataLine] (sum)
(sum-eom) edge [DataLine] (eom)
(split-eom) edge [DataLine] (eom)
(split) edge [DataLine] (output_split)
(atm) edge [DataLine] (output_atm)
(air) edge [DataLine] (output_air)
(loads) edge [DataLine] (output_loads)
(sum) edge [DataLine] (output_sum)
(eom) edge [DataLine] (output_eom);
\end{pgfonlayer}

\end{tikzpicture}
