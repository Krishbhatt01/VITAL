% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (plant) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (lin) [join=by ProcessHVA];
\chainin (jac) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (jac) [join=by ProcessHVA];
\chainin (lin) [join=by ProcessHVA];
\chainin (modes) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (sim) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\chainin (ctl) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (lin);
\chainin (xchk) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(trim) edge [DataLine] (trim-plant)
(plant) edge [DataLine] (plant-trim)
(trim) edge [DataLine] (trim-lin)
(lin) edge [DataLine] (lin-jac)
(jac) edge [DataLine] (jac-plant)
(plant) edge [DataLine] (plant-jac)
(jac) edge [DataLine] (jac-lin)
(lin) edge [DataLine] (lin-modes)
(trim) edge [DataLine] (trim-sim)
(sim) edge [DataLine] (sim-plant)
(plant) edge [DataLine] (plant-sim)
(sim) edge [DataLine] (sim-ctl)
(ctl) edge [DataLine] (ctl-sim)
(lin) edge [DataLine] (lin-xchk)
(sim) edge [DataLine] (sim-xchk)
(trim) edge [DataLine] (right_output_trim)
(modes) edge [DataLine] (right_output_modes)
(sim) edge [DataLine] (right_output_sim)
(xchk) edge [DataLine] (right_output_xchk)
% Vertical edges
(trim-plant) edge [DataLine] (plant)
(plant-trim) edge [DataLine] (trim)
(trim-lin) edge [DataLine] (lin)
(lin-jac) edge [DataLine] (jac)
(jac-plant) edge [DataLine] (plant)
(plant-jac) edge [DataLine] (jac)
(jac-lin) edge [DataLine] (lin)
(lin-modes) edge [DataLine] (modes)
(trim-sim) edge [DataLine] (sim)
(sim-plant) edge [DataLine] (plant)
(plant-sim) edge [DataLine] (sim)
(sim-ctl) edge [DataLine] (ctl)
(ctl-sim) edge [DataLine] (sim)
(lin-xchk) edge [DataLine] (xchk)
(sim-xchk) edge [DataLine] (xchk)
(trim) edge [DataLine] (output_trim)
(sim) edge [DataLine] (output_sim);
\end{pgfonlayer}

