% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (data);
\chainin (read) [join=by ProcessHVA];
\chainin (mod) [join=by ProcessHVA];
\chainin (cfg) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (plant) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (lin) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (lin) [join=by ProcessHVA];
\chainin (modes) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (sim) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\chainin (ctl) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (sim);
\chainin (nesc) [join=by ProcessHVA];
\chainin (rot) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\chainin (nesc) [join=by ProcessHVA];
\chainin (cmp) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (modes);
\chainin (fq) [join=by ProcessHVA];
\chainin (test) [join=by ProcessHVA];
\end{pgfonlayer}
}

