\input{"C:/Users/krish/AppData/Local/Programs/Python/Python310/lib/site-packages/pyxdsm/diagram_styles"}
\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
\node [DataIO] (output_case) {$\text{case id: 1 to 16}$};&
&
&
&
&
&
&
\node [DataIO] (output_cmp) {$\begin{array}{c}\text{NASA reference CSVs} \\ \text{(simulators 1 to 6)}\end{array}$};&
&
\\
%Row 1
\node [Function] (case) {$\begin{array}{c}\text{1: Case definition} \\ \texttt{+nesc/caseDef}\end{array}$};&
\node [DataInter] (case-veh) {$\begin{array}{c}\text{vehicle id,} \\ \text{overrides}\end{array}$};&
\node [DataInter] (case-trim) {$\begin{array}{c}\text{start: lat, lon,} \\ \text{h, V (F-16)}\end{array}$};&
&
&
\node [DataInter] (case-sim) {$\text{dt, duration}$};&
&
\node [DataInter] (case-cmp) {$\begin{array}{c}\text{bands: floor,} \\ \text{k, spread}\end{array}$};&
&
\\
%Row 2
&
\node [Function] (veh) {$\begin{array}{c}\text{2: Vehicle} \\ \texttt{+nesc/vehicle, f16 config}\end{array}$};&
&
&
\node [DataInter] (veh-plant) {$\text{AC}$};&
&
&
&
&
\\
%Row 3
&
&
\node [Function] (trim) {$\begin{array}{c}\text{3: F-16 trim} \\ \texttt{+nesc/f16Trim}\end{array}$};&
\node [DataInter] (trim-ctl) {$\begin{array}{c}\text{trim controls,} \\ \text{reference states}\end{array}$};&
&
\node [DataInter] (trim-sim) {$\text{start state x0}$};&
&
&
&
\\
%Row 4
&
&
&
\node [Function] (ctl) {$\begin{array}{c}\text{4: NASA control law} \\ \texttt{+nesc/f16Controller}\end{array}$};&
\node [DataInter] (ctl-plant) {$\begin{array}{c}\text{commands become u} \\ \text{at each stage}\end{array}$};&
&
&
&
&
\\
%Row 5
&
&
&
&
\node [Function] (plant) {$\begin{array}{c}\text{5: Rotating-Earth plant} \\ \texttt{derivativesRotating}\end{array}$};&
\node [DataInter] (plant-sim) {$\text{xdot, y}$};&
&
&
&
\\
%Row 6
&
&
&
&
\node [DataInter] (sim-plant) {$\text{x(t), u}$};&
\node [MDA] (sim) {$\begin{array}{c}\text{6: Time simulation} \\ \texttt{+sim/run}\end{array}$};&
\node [DataInter] (sim-sig) {$\text{time histories (SI)}$};&
&
&
\\
%Row 7
&
&
&
&
&
&
\node [Function] (sig) {$\begin{array}{c}\text{7: NESC signals} \\ \texttt{+nesc/runCase}\end{array}$};&
\node [DataInter] (sig-cmp) {$\begin{array}{c}\text{NASA names} \\ \text{and units}\end{array}$};&
&
\node [DataIO] (right_output_sig) {$\text{NESC-named time series}$};\\
%Row 8
&
&
&
&
&
&
&
\node [Function] (cmp) {$\begin{array}{c}\text{8: Compare with NASA} \\ \texttt{+nesc/compare}\end{array}$};&
&
\node [DataIO] (right_output_cmp) {$\begin{array}{c}\text{PASS / FAIL and} \\ \text{excess per signal}\end{array}$};\\
%Row 9
&
&
&
&
&
&
&
&
&
\\
};

% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (case);
\chainin (veh) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\chainin (ctl) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\chainin (plant) [join=by ProcessHVA];
\chainin (sim) [join=by ProcessHVA];
\chainin (sig) [join=by ProcessHVA];
\chainin (cmp) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(case) edge [DataLine] (case-veh)
(case) edge [DataLine] (case-trim)
(veh) edge [DataLine] (veh-plant)
(trim) edge [DataLine] (trim-ctl)
(trim) edge [DataLine] (trim-sim)
(case) edge [DataLine] (case-sim)
(ctl) edge [DataLine] (ctl-plant)
(sim) edge [DataLine] (sim-plant)
(plant) edge [DataLine] (plant-sim)
(sim) edge [DataLine] (sim-sig)
(sig) edge [DataLine] (sig-cmp)
(case) edge [DataLine] (case-cmp)
(sig) edge [DataLine] (right_output_sig)
(cmp) edge [DataLine] (right_output_cmp)
% Vertical edges
(case-veh) edge [DataLine] (veh)
(case-trim) edge [DataLine] (trim)
(veh-plant) edge [DataLine] (plant)
(trim-ctl) edge [DataLine] (ctl)
(trim-sim) edge [DataLine] (sim)
(case-sim) edge [DataLine] (sim)
(ctl-plant) edge [DataLine] (plant)
(sim-plant) edge [DataLine] (plant)
(plant-sim) edge [DataLine] (sim)
(sim-sig) edge [DataLine] (sig)
(sig-cmp) edge [DataLine] (cmp)
(case-cmp) edge [DataLine] (cmp)
(case) edge [DataLine] (output_case)
(cmp) edge [DataLine] (output_cmp);
\end{pgfonlayer}

\end{tikzpicture}
