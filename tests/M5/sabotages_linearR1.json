  "targets": [
   "tLinearizeR1/eulerRatesMatchQuaternionKinematics",
   "tLinearizeR1/eulerRatesJacobianIsAnalytic"
  ],
  "rationale": "R1-L2: sign of r sin(phi) in thetadot (R1 M4)."
 },
 {
