[
 {
  "id": "S0-1",
  "file": "+vital/+test/VitalTestCase.m",
  "pattern": "allowed = tol * ones(size(err));",
  "replacement": "allowed = max(tol, tol .* abs(expected)) .* ones(size(err));",
  "targets": [
   "tVitalTestCase/absModeIgnoresRelTolerance"
  ],
  "rationale": "An absolute tolerance that silently accepts a relative error must be caught."
 },
 {
  "id": "S0-2",
  "file": "+vital/+test/classifyResults.m",
  "pattern": "if strcmp(recs(k).Exception.identifier, 'vital:notImplemented')",
  "replacement": "if contains(string(recs(k).Report), 'vital:notImplemented')",
  "targets": [
   "tRunnerClassification/otherErrorIsRedUnexpected"
  ],
  "rationale": "Classifying by message text instead of error identifier lets an unrelated error pose as a stub (the bug fixed during M0)."
 },
 {
  "id": "S0-3",
  "file": "+vital/+test/selectMilestone.m",
  "pattern": "inRange = any(nums <= mk);",
  "replacement": "inRange = any(nums < mk);",
  "targets": [
   "tRunnerClassification/milestoneSelectionIsCumulative"
  ],
  "rationale": "An off-by-one in cumulative selection would silently drop the current milestone's tests from its own gate."
 },
 {
  "id": "S0-4",
  "file": "+vital/+test/treeHash.m",
  "pattern": "if ~isempty(bytes), md.update(typecast(bytes, 'int8')); end",
  "replacement": "",
  "targets": [
   "tSabotageHarness/originalTreeUnchanged"
  ],
  "rationale": "A tree hash that ignores file contents could not detect that a sabotage edited the real tree."
 },
 {
  "id": "S0-5",
  "file": "+vital/+io/checkCatalogue.m",
  "pattern": "    if ismember(ms, closed) && planned",
  "replacement": "    if false",
  "targets": [
   "tCatalogueRules/closedMilestonePlannedRowIsAProblem"
  ],
  "rationale": "A closed milestone with a PLANNED failure-catalogue row would claim coverage that does not exist."
 },
 {
  "id": "S0-6",
  "file": "+vital/+test/applySabotage.m",
  "pattern": "    sub = sub(~ismember({sub.name}, {'.', '..', 'work'}));",
  "replacement": "    sub = sub([]);",
  "targets": [
   "tSabotageReports/copyHasReportsButNotScratch",
   "tSabotageReports/nullSabotageNotDetected"
  ],
  "rationale": "Review R3 B1 regression: the sabotage copy loses reports/ again, so tests that read reports fail on any edit (vacuous detections)."
 }
]